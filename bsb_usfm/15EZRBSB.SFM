\v 31 the descendants of \zwd the other Elam|\zwd*,\f + \fr 2:31 \ft Or of West Elam\f* 1,254; 
\b
\li1 
\v 32 the descendants of \zwd Harim|\zwd*, 320; 
\b
\li1 
\v 33 the men of Lod, Hadid, and Ono, 725; 
\b
\li1 
\v 34 the men of Jericho, 345; 
\b
\li1 
\v 35 and the descendants of \zwd Senaah|\zwd*, 3,630. 
\b
\m 
\v 36 The priests: 
\b
\li1 The descendants of \zwd Jedaiah|\zwd* (through the house of \zwd Jeshua|\zwd*), 973; 
\b
\li1 
\v 37 the descendants of \zwd Immer|\zwd*, 1,052; 
\b
\li1 
\v 38 the descendants of \zwd Pashhur|\zwd*, 1,247; 
\b
