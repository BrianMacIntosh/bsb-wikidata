\b
\li1 \zwd Parosh|\zwd*, \zwd Pahath-moab|\zwd*, \zwd Elam|\zwd*, \zwd Zattu|Q138862844\zwd*, \zwd Bani|Q139799192\zwd*, 
\b
\li1 
\v 15 \zwd Bunni|\zwd*, \zwd Azgad|Q139575205\zwd*, \zwd Bebai|Q140146976\zwd*, 
