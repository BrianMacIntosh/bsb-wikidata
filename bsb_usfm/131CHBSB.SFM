\id 1CH - Berean Standard Bible
\h 1 Chronicles
\toc2 1 Chronicles
\toc1 1 Chronicles
\mt1 1 Chronicles
\c 1
\s1 From Adam to Abraham
\r (Genesis 5:1–32; Genesis 10:1–32; Genesis 11:10–26)
\m
\v 1 \zwd Adam|id="Q70899" t="2"\zwd*, \zwd Seth|id="Q107626" t="2"\zwd*, \zwd Enosh|id="Q682531" t="2"\zwd*,
\b
\m
\v 2 \zwd Kenan|id="Q844433" t="2"\zwd*, \zwd Mahalalel|id="Q10297002" t="2"\zwd*, \zwd Jared|id="Q927410" t="2"\zwd*,
\b
\m
\v 3 \zwd Enoch|id="Q213027" t="2"\zwd*, \zwd Methuselah|id="Q156290" t="2"\zwd*, \zwd Lamech|id="Q10921342" t="2"\zwd*, \zwd Noah|id="Q81422" t="2"\zwd*.
\b
\m
\v 4 The sons of \zwd Noah|id="Q81422" t="2"\zwd*:\f + \fr 1:4 \ft LXX; Hebrew does not include The sons of Noah:; see Genesis 5:32.\f*
\b
\li1 \zwd Shem|id="Q200902" t="2"\zwd*, \zwd Ham|id="Q229702" t="2"\zwd*, and \zwd Japheth|id="Q200637" t="2"\zwd*.
\b
\li1
\v 5 The sons of \zwd Japheth|id="Q200637" t="2"\zwd*:
\b
\li2 \zwd Gomer|id="Q1148172" t="2"\zwd*, \zwd Magog|id="Q1964706" t="2"\zwd*, \zwd Madai|id="Q1790796" t="2"\zwd*, \zwd Javan|id="Q1684266" t="2"\zwd*, \zwd Tubal|id="Q1481766" t="2"\zwd*, \zwd Meshech|id="Q30973" t="2"\zwd*, and \zwd Tiras|id="Q1481751" t="2"\zwd*.
\b
\li2
\v 6 The sons of \zwd Gomer|id="Q1148172" t="2"\zwd*: \zwd Ashkenaz|id="Q722770" t="2"\zwd*, \zwd Riphath|id="Q2918052" t="2"\zwd*,\f + \fr 1:6 \ft Many Hebrew manuscripts and Vulgate (see also LXX and Genesis 10:3); most Hebrew manuscripts Diphath\f* and \zwd Togarmah|id="Q1068499" t="2"\zwd*.
\b
\li2
\v 7 And the sons of \zwd Javan|id="Q1684266" t="2"\zwd*: \zwd Elishah|id="Q1330627" t="2"\zwd*, \zwd Tarshish|\zwd*, the Kittites, and the Rodanites.
\b
\li1
\v 8 The sons of \zwd Ham|Q229702\zwd*:
\b
\li2 \zwd Cush|id="Q1138595" t="2"\zwd*, \zwd Mizraim|id="Q1369215" t="2"\zwd*, \zwd Put|id="Q946939" t="2"\zwd*, and \zwd Canaan|id="Q204797" t="2"\zwd*.
\b
\li2
\v 9 The sons of \zwd Cush|id="Q1138595" t="2"\zwd*: \zwd Seba|id="Q23639444" t="2"\zwd*, \zwd Havilah|id="Q32945196" t="2"\zwd*, \zwd Sabta|id="Q13143737" t="2"\zwd*,\f + \fr 1:9 \ft Sabta is a variant of Sabtah; see Genesis 10:7.\f* \zwd Raamah|id="Q3085764" t="2"\zwd*, and \zwd Sabteca|id="Q124169540" t="2"\zwd*.
\b
\li2 The sons of \zwd Raamah|id="Q3085764" t="2"\zwd*: \zwd Sheba|id="Q125399193" t="2"\zwd* and \zwd Dedan|id="Q124305605" t="2"\zwd*.
\b
\li2
\v 10 \zwd Cush|id="Q1138595" t="2"\zwd* was the father of \zwd Nimrod|id="Q201861" t="2"\zwd*, who began to be a mighty one \f + \fr 1:10 \ft Or who established himself as a mighty warrior\f* on the earth.
\b
\li2
\v 11 \zwd Mizraim|id="Q1369215" t="2"\zwd* was the father of the Ludites, the Anamites, the Lehabites, the Naphtuhites,
\v 12 the Pathrusites, the Casluhites (from whom the Philistines came), and the Caphtorites.\f + \fr 1:12 \ft Some translators adjust the Hebrew word order to the Casluhites, and the Caphtorites (from whom the Philistines came); see also Jeremiah 47:4 and Amos 9:7.\f*
\b
\li2
\v 13 And \zwd Canaan|id="Q204797" t="2"\zwd* was the father of \zwd Sidon his firstborn|id="Q3541553" t="2"\zwd*,\f + \fr 1:13 \ft Or of the Sidonians, the foremost\f* and of the Hittites,\f + \fr 1:13 \ft Hebrew and of \zwd Heth|id="Q2335214" t="2"\zwd*\f*
\v 14 the Jebusites, the Amorites, the Girgashites,
\v 15 the Hivites, the Arkites, the Sinites,
\v 16 the Arvadites, the Zemarites, and the Hamathites.
\b
\li1
\v 17 The sons of \zwd Shem|id="Q200902" t="2"\zwd*:
\b
\li2 \zwd Elam|id="Q1147704" t="2"\zwd*, \zwd Asshur|id="Q2426606" t="2"\zwd*, \zwd Arphaxad|id="Q457520" t="2"\zwd*, \zwd Lud|id="Q1815870" t="2"\zwd*, and \zwd Aram|id="Q625667" t="2"\zwd*.
\b
\li2 The sons of \zwd Aram|id="Q625667" t="2"\zwd*: \f + \fr 1:17 \ft One Hebrew manuscript and some LXX manuscripts (see also Genesis 10:23); most Hebrew manuscripts do not include The sons of Aram.\f* \zwd Uz|id="Q2558734" t="2"\zwd*, \zwd Hul|id="Q2898616" t="2"\zwd*, \zwd Gether|id="Q2910407" t="2"\zwd*, and \zwd Meshech|id="Q13418757" t="2"\zwd*.\f + \fr 1:17 \ft Meshech is a variant of Mash; see Genesis 10:23.\f*
\b
\li2
\v 18 \zwd Arphaxad|id="Q457520" t="2"\zwd* was the father of \zwd Shelah|id="Q1827950" t="2"\zwd*, and \zwd Shelah|id="Q1827950" t="2"\zwd* was the father of \zwd Eber|id="Q502282" t="2"\zwd*.
\b
\li2
\v 19 \zwd Two sons|id="Q1648259,Q1553059" t="2"\zwd* were born to \zwd Eber|id="Q502282" t="2"\zwd*: One was named \zwd Peleg|id="Q1648259" t="2"\zwd*,\f + \fr 1:19 \ft Peleg means division.\f* because in his days the earth was divided, and his brother was named \zwd Joktan|id="Q1553059" t="2"\zwd*.
\b
\li2
\v 20 And \zwd Joktan|id="Q1553059" t="2"\zwd* was the father of \zwd Almodad|id="Q2905798" t="2"\zwd*, \zwd Sheleph|id="Q7493584" t="2"\zwd*, \zwd Hazarmaveth|id="Q2905463" t="2"\zwd*, \zwd Jerah|id="Q18276083" t="2"\zwd*,
\v 21 \zwd Hadoram|id="Q5638029" t="2"\zwd*, \zwd Uzal|id="Q7904500" t="2"\zwd*, \zwd Diklah|id="Q63433898" t="2"\zwd*,
\v 22 \zwd Obal|id="Q115760490" t="2"\zwd*,\f + \fr 1:22 \ft LXX and Syriac (see also Genesis 10:28); Hebrew Ebal\f* \zwd Abimael|id="Q14925390" t="2"\zwd*, \zwd Sheba|id="Q138636936" t="2"\zwd*,
\v 23 \zwd Ophir|id="Q125345983" t="2"\zwd*, \zwd Havilah|id="Q138636935" t="2"\zwd*, and \zwd Jobab|id="Q44123555" t="2"\zwd*. All these were sons of \zwd Joktan|id="Q1553059" t="2"\zwd*.
\b
\li2
\v 24 So from \zwd Shem|id="Q200902" t="2"\zwd* came \zwd Arphaxad|id="Q457520" t="2"\zwd*, \zwd Shelah|id="Q1827950" t="2"\zwd*,\f + \fr 1:24 \ft Literally Shem, Arphaxad, Shelah; some LXX manuscripts Shem, Arphaxad, Cainan, Shelah; see also Genesis 10:24 LXX and Luke 3:35–36.\f*
\v 25 \zwd Eber|id="Q502282" t="2"\zwd*, \zwd Peleg|id="Q1648259" t="2"\zwd*, \zwd Reu|id="Q2040793" t="2"\zwd*,
\v 26 \zwd Serug|id="Q1161313" t="2"\zwd*, \zwd Nahor|id="Q888890" t="2"\zwd*, \zwd Terah|id="Q586541" t="2"\zwd*,
\v 27 and \zwd Abram|id="Q9181" t="2"\zwd* (that is, \zwd Abraham|id="Q9181" t="2"\zwd*).
\s1 The Descendants of Abraham
\r (Genesis 25:12–18)
\b
\m
\v 28 The sons of \zwd Abraham|id="Q9181" t="2"\zwd* were \zwd Isaac|id="Q671872" t="2"\zwd* and \zwd Ishmael|id="Q183403" t="2"\zwd*.
\v 29 These are their genealogies:
\b
\li1 \zwd Nebaioth the firstborn of \zwd Ishmael|id="Q183403" t="2"\zwd*|id="Q3773487" t="2"\zwd*, then \zwd Kedar|id="Q21087985" t="2"\zwd*, \zwd Adbeel|id="Q24238724" t="2"\zwd*, \zwd Mibsam|id="Q14925213" t="2"\zwd*,
\v 30 \zwd Mishma|id="Q20101216" t="2"\zwd*, \zwd Dumah|id="Q5313606" t="2"\zwd*, \zwd Massa|id="Q21087988" t="2"\zwd*, \zwd Hadad|id="Q22004334" t="2"\zwd*, \zwd Tema|id="Q20101919" t="2"\zwd*,
\v 31 \zwd Jetur|id="Q11927540" t="2"\zwd*, \zwd Naphish|id="Q10335361" t="2"\zwd*, and \zwd Kedemah|id="Q11944201" t="2"\zwd*. These were the sons of \zwd Ishmael|id="Q183403" t="2"\zwd*.
\b
\li1
\v 32 The sons born to \zwd Keturah|id="Q908531" t="2"\zwd*, \zwd Abraham|id="Q9181" t="2"\zwd*’s concubine:
\b
\li2 \zwd Zimran|id="Q786540" t="2"\zwd*, \zwd Jokshan|id="Q737548" t="2"\zwd*, \zwd Medan|id="Q1212757" t="2"\zwd*, \zwd Midian|id="Q755316" t="2"\zwd*, \zwd Ishbak|id="Q594903" t="2"\zwd*, and \zwd Shuah|id="Q369850" t="2"\zwd*.
\b
\li1 The sons of \zwd Jokshan|id="Q737548" t="2"\zwd*:
\b
\li2 \zwd Sheba|id="Q9332549" t="2"\zwd* and \zwd Dedan|id="Q124819618" t="2"\zwd*.
\b
\li1
\v 33 The sons of \zwd Midian|id="Q755316" t="2"\zwd*:
\b
\li2 \zwd Ephah|id="Q5382125" t="2"\zwd*, \zwd Epher|id="Q5382171" t="2"\zwd*, \zwd Hanoch|id="Q108207665" t="2"\zwd*, \zwd Abida|id="Q3314892" t="2"\zwd*, and \zwd Eldaah|id="Q124325068" t="2"\zwd*.
\b
\li2 All of these were \zwd Keturah|id="Q908531" t="2"\zwd*’s sons.
\b
\li1
\v 34 \zwd Abraham|id="Q9181" t="2"\zwd* was the father of \zwd Isaac|id="Q671872" t="2"\zwd*. The sons of \zwd Isaac|id="Q671872" t="2"\zwd*:
\b
\li2 \zwd Esau|id="Q220822" t="2"\zwd* and \zwd Israel|id="Q289957" t="2"\zwd*.
\s1 The Descendants of Esau
\r (Genesis 36:1–19)
\b
\li1
\v 35 The sons of \zwd Esau|id="Q220822" t="2"\zwd*:
\b
\li2 \zwd Eliphaz|id="Q2899130" t="2"\zwd*, \zwd Reuel|id="Q32979741" t="2"\zwd*, \zwd Jeush|id="Q10306885" t="2"\zwd*, \zwd Jalam|id="Q125263542" t="2"\zwd*, and \zwd Korah|id="Q85774893" t="2"\zwd*.
\b
\li2
\v 36 The sons of \zwd Eliphaz|id="Q2899130" t="2"\zwd*: \zwd Teman|id="Q134715631" t="2"\zwd*, \zwd Omar|id="Q7089609" t="2"\zwd*, \zwd Zepho|id="Q8069299" t="2"\zwd*,\f + \fr 1:36 \ft Many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also Genesis 36:11); most Hebrew manuscripts Zephi\f* \zwd Gatam|id="Q106145044" t="2"\zwd*, and \zwd Kenaz|id="Q114627203" t="2"\zwd*; and by \zwd Timna|id="Q32979730" t="2"\zwd*, \zwd Amalek|id="Q372091" t="2"\zwd*.
\b
\li2
\v 37 The sons of \zwd Reuel|id="Q32979741" t="2"\zwd*: \zwd Nahath|id="Q108487406" t="2"\zwd*, \zwd Zerah|id="Q108487424" t="2"\zwd*, \zwd Shammah|id="Q114627891" t="2"\zwd*, and \zwd Mizzah|id="Q6884915" t="2"\zwd*.
\s1 The Descendants of Seir
\r (Genesis 36:20–30)
\b
\li1
\v 38 The sons of \zwd Seir|id="Q42532277" t="2"\zwd*:
\b
\li2 \zwd Lotan|id="Q6684617" t="2"\zwd*, \zwd Shobal|id="Q125423902" t="2"\zwd*, \zwd Zibeon|id="Q42532003" t="2"\zwd*, \zwd Anah|id="Q42532204" t="2"\zwd*, \zwd Dishon|id="Q124820244" t="2"\zwd*, \zwd Ezer|id="Q10274802" t="2"\zwd*, and \zwd Dishan|id="Q124820697" t="2"\zwd*.
\b
\li2
\v 39 The sons of \zwd Lotan|id="Q6684617" t="2"\zwd*: \zwd Hori|id="Q55120394" t="2"\zwd* and \zwd Homam|id="Q106084820" t="2"\zwd*.\f + \fr 1:39 \ft Homam is a variant of Hemam; see Genesis 36:22.\f* \zwd Timna|\zwd* was \zwd Lotan|id="Q6684617" t="2"\zwd*’s sister.
\b
\li2
\v 40 The sons of \zwd Shobal|id="Q125423902" t="2"\zwd*: \zwd Alvan|id="Q124552466" t="2"\zwd*,\f + \fr 1:40 \ft LXX (see also Genesis 36:23); Hebrew Alian \f* \zwd Manahath|id="Q125315789" t="2"\zwd*, \zwd Ebal|id="Q125045346" t="2"\zwd*, \zwd Shepho|id="Q138580874" t="2"\zwd*,\f + \fr 1:40 \ft LXX (see also Genesis 36:23); Hebrew Shephi\f* and \zwd Onam|id="Q138580877" t="2"\zwd*.
\b
\li2 The sons of \zwd Zibeon|id="Q42532003" t="2"\zwd*: \zwd Aiah|id="Q123189281" t="2"\zwd* and \zwd Anah|id="Q42532204" t="2"\zwd*.
\b
\li2
\v 41 The son \f + \fr 1:41 \ft Hebrew sons \f* of \zwd Anah|id="Q42532204" t="2"\zwd*: \zwd Dishon|id="Q124821119" t="2"\zwd*.
\b
\li2 The sons of \zwd Dishon|id="Q124820244" t="2"\zwd*: \zwd Hemdan|id="Q124556126" t="2"\zwd*,\f + \fr 1:41 \ft LXX (see also Genesis 36:26); Hebrew Hamran\f* \zwd Eshban|id="Q125038626" t="2"\zwd*, \zwd Ithran|id="Q125263780" t="2"\zwd*, and \zwd Cheran|id="Q138580889" t="2"\zwd*.
\b
\li2
\v 42 The sons of \zwd Ezer|id="Q10274802" t="2"\zwd*: \zwd Bilhan|id="Q140363313" t="2"\zwd*, \zwd Zaavan|id="Q125498533" t="2"\zwd*, and \zwd Akan|\zwd*.\f + \fr 1:42 \ft LXX (see also Genesis 36:27); Hebrew Jaakan\f*
\b
\li2 The sons of \zwd Dishan|id="Q124820697" t="2"\zwd*: \zwd Uz|id="Q138580891" t="2"\zwd* and \zwd Aran|id="Q124556347" t="2"\zwd*.
\s1 The Kings of Edom
\r (Genesis 36:31–43)
\b
\m
\v 43 These are the kings who reigned in the land of Edom before any king reigned over the Israelites:\f + \fr 1:43 \ft Or before an Israelite king ruled over them\f*
\b
\li1 \zwd Bela son of \zwd Beor|id="Q124759391" t="2"\zwd*|id="Q4081479" t="2"\zwd*. His city was named Dinhabah.
\b
\li1
\v 44 When \zwd Bela|id="Q4081479" t="2"\zwd* died, \zwd Jobab son of \zwd Zerah|\zwd*|id="Q6206768" t="2"\zwd* from Bozrah reigned in his place.
\b
\li1
\v 45 When \zwd Jobab|id="Q6206768" t="2"\zwd* died, \zwd Husham|id="Q5949264" t="2"\zwd* from the land of the Temanites reigned in his place.
\b
\li1
\v 46 When \zwd Husham|id="Q5949264" t="2"\zwd* died, \zwd Hadad son of \zwd Bedad|id="Q124759472" t="2"\zwd*|id="Q5637556" t="2"\zwd*, who defeated Midian in the country of Moab, reigned in his place. And the name of his city was Avith.
\b
\li1
\v 47 When \zwd Hadad|id="Q5637556" t="2"\zwd* died, \zwd Samlah from Masrekah|id="Q7409616" t="2"\zwd* reigned in his place.
\b
\li1
\v 48 When \zwd Samlah|id="Q7409616" t="2"\zwd* died, \zwd Shaul|id="Q138580913" t="2"\zwd* from Rehoboth on the Euphrates \f + \fr 1:48 \ft Hebrew the River\f* reigned in his place.
\b
\li1
\v 49 When \zwd Shaul|id="Q138580913" t="2"\zwd* died, \zwd Baal-hanan son of \zwd Achbor|id="Q135454512" t="2"\zwd*|id="Q5717054" t="2"\zwd* reigned in his place.
\b
\li1
\v 50 When \zwd Baal-hanan|id="Q5717054" t="2"\zwd* died, \zwd Hadad|id="Q134468308" t="2"\zwd* reigned in his place. His city was named Pau,\f + \fr 1:50 \ft Many MT manuscripts, some LXX manuscripts, Vulgate, and Syriac (see also Genesis 36:39); most MT manuscripts Pai\f* and his wife’s name was \zwd Mehetabel daughter of \zwd Matred|id="Q125271641" t="2"\zwd*|id="Q93697104" t="2"\zwd*, the daughter of \zwd Me-zahab|id="Q125316367" t="2"\zwd*.
\b
\li1
\v 51 Then \zwd Hadad|id="Q134468308" t="2"\zwd* died.
\b
\m Now the chiefs of Edom were \zwd Timna|\zwd*, \zwd Alvah|\zwd*, \zwd Jetheth|\zwd*,
\v 52 \zwd Oholibamah|\zwd*, \zwd Elah|\zwd*, \zwd Pinon|\zwd*,
\v 53 \zwd Kenaz|\zwd*, \zwd Teman|\zwd*, \zwd Mibzar|\zwd*,
\v 54 \zwd Magdiel|\zwd*, and \zwd Iram|\zwd*. These were the chiefs of Edom.
\c 2
\s1 The Sons of Israel
\r (Genesis 35:21–26; Genesis 38:1–30)
\m 
\v 1 These were the sons of \zwd Israel|id="Q289957" t="2"\zwd*: 
\b
\li1 \zwd Reuben|id="Q625661" t="2"\zwd*, \zwd Simeon|id="Q1773005" t="2"\zwd*, \zwd Levi|id="Q215512" t="2"\zwd*, \zwd Judah|id="Q282220" t="2"\zwd*, \zwd Issachar|id="Q651256" t="2"\zwd*, \zwd Zebulun|id="Q614575" t="2"\zwd*, 
\v 2 \zwd Dan|id="Q550869" t="2"\zwd*, \zwd Joseph|id="Q145746" t="2"\zwd*, \zwd Benjamin|id="Q460763" t="2"\zwd*, \zwd Naphtali|id="Q1771963" t="2"\zwd*, \zwd Gad|id="Q851749" t="2"\zwd*, and \zwd Asher|id="Q1775026" t="2"\zwd*. 
\b
\li1 
\v 3 The sons of \zwd Judah|id="Q282220" t="2"\zwd*: 
\b
\li2 \zwd Er|id="Q1347943" t="2"\zwd*, \zwd Onan|id="Q661074" t="2"\zwd*, and \zwd Shelah|id="Q1294423" t="2"\zwd*. These three were born to him by \zwd Bath-shua the Canaanite|id="Q6940768" t="2"\zwd*. \zwd Er|id="Q1347943" t="2"\zwd*, \zwd Judah|id="Q282220" t="2"\zwd*’s firstborn, was wicked in the sight of the LORD. So the LORD put him to death. 
\b
\li2 
\v 4 \zwd Tamar|id="Q1030008" t="2"\zwd*, \zwd Judah|id="Q282220" t="2"\zwd*’s daughter-in-law, bore to him \zwd Perez|id="Q1814684" t="2"\zwd* and \zwd Zerah|id="Q3223065" t="2"\zwd*. \zwd Judah|id="Q282220" t="2"\zwd* had \zwd five sons|id="Q1347943,Q661074,Q1294423,Q1814684,Q3223065" t="2"\zwd* in all. 
\b
\li1 
\v 5 The sons of \zwd Perez|id="Q1814684" t="2"\zwd*: 
\b
\li2 \zwd Hezron|id="Q4177234" t="2"\zwd* and \zwd Hamul|id="Q65129982" t="2"\zwd*. 
\b
\li1 
\v 6 The sons of \zwd Zerah|id="Q3223065" t="2"\zwd*: 
\b
\li2 \zwd Zimri|id="Q114671090" t="2"\zwd*,\f + \fr 2:6 \ft Zimri is a variant of Zabdi; see Joshua 7:1.\f* \zwd Ethan|\zwd*, \zwd Heman|\zwd*, \zwd Calcol|\zwd*, and \zwd Dara|\zwd* \f + \fr 2:6 \ft Most Hebrew manuscripts; many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also 1 Kings 4:31) Darda\f*—five in all. 
\b
\li1 
\v 7 The son \f + \fr 2:7 \ft Hebrew sons\f* of \zwd Carmi|id="Q114672619" t="2"\zwd*: 
\b
\li2 \zwd Achar|id="Q1889647" t="2"\zwd*,\f + \fr 2:7 \ft Achar means troubler; also called Achan in Joshua 7 and Joshua 22.\f* who brought trouble upon Israel by violating the ban on devoted things. 
\b
\li1 
\v 8 The son of \zwd Ethan|\zwd*: 
\b
\li2 \zwd Azariah|\zwd*. 
\b
\li1 
\v 9 The sons who were born to \zwd Hezron|id="Q4177234" t="2"\zwd*: 
\b
\li2 \zwd Jerahmeel|id="Q1687510" t="2"\zwd*, \zwd Ram|id="Q1824842" t="2"\zwd*, and \zwd Caleb|id="Q16938772" t="2"\zwd*.\f + \fr 2:9 \ft Hebrew Chelubai, a variant of Caleb; see verse 18.\f* 
\b
\li1 
\v 10 \zwd Ram|id="Q1824842" t="2"\zwd* was the father of \zwd Amminadab|id="Q2038223" t="2"\zwd*, and \zwd Amminadab|id="Q2038223" t="2"\zwd* was the father of \zwd Nahshon|id="Q1784980" t="2"\zwd*, a leader of the descendants of \zwd Judah|id="Q282220" t="2"\zwd*. 
\b
\li1 
\v 11 \zwd Nahshon|id="Q1784980" t="2"\zwd* was the father of \zwd Salmon|id="Q1771358" t="2"\zwd*,\f + \fr 2:11 \ft LXX (see also Ruth 4:20–21); Hebrew Salma; twice in this verse\f* and \zwd Salmon|id="Q1771358" t="2"\zwd* was the father of \zwd Boaz|id="Q212253" t="2"\zwd*. 
\b
\li1 
\v 12 \zwd Boaz|id="Q212253" t="2"\zwd* was the father of \zwd Obed|id="Q1135791" t="2"\zwd*, and \zwd Obed|id="Q1135791" t="2"\zwd* was the father of \zwd Jesse|id="Q45090" t="2"\zwd*. 
\b
\li1 
\v 13 \zwd Jesse|id="Q45090" t="2"\zwd* was the father of \zwd Eliab his firstborn|id="Q96105737" t="2"\zwd*; \zwd Abinadab|id="Q11903854" t="2"\zwd* was born second, \zwd Shimea|id="Q16130530" t="2"\zwd* \f + \fr 2:13 \ft Shimea is a variant of Shammah, Shimeah, and Shimei; see 1 Samuel 16:9, 2 Samuel 13:3, and 2 Samuel 21:21.\f* third, 
\v 14 \zwd Nethanel|id="Q117074434" t="2"\zwd* fourth, \zwd Raddai|id="Q117074438" t="2"\zwd* fifth, 
\v 15 \zwd Ozem|id="Q117074443" t="2"\zwd* sixth, and \zwd David|id="Q41370" t="2"\zwd* seventh. 
\v 16 Their sisters were \zwd Zeruiah|id="Q196771" t="2"\zwd* and \zwd Abigail|id="Q3603697" t="2"\zwd*. And the three sons of Zeruiah were \zwd Abishai|id="Q1154317" t="2"\zwd*, \zwd Joab|id="Q1141064" t="2"\zwd*, and \zwd Asahel|id="Q2915076" t="2"\zwd*. 
\v 17 \zwd Abigail|id="Q3603697" t="2"\zwd* was the mother of \zwd Amasa|id="Q2689456" t="2"\zwd*, whose father was \zwd Jether \f + \fr 2:17 \ft Jether is a variant of Ithra; see 2 Samuel 17:25.\f* the Ishmaelite|id="Q6659565" t="2"\zwd*. 
